{
  "name": "thecozybudph",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    // https://supabase.com/docs/guides/functions/quickstart
    "dev-db": "pnpm dlx supabase --workdir ./backend/src/db", // append with start, stop, restart, status, etc.
    "dev-db-start": "pnpm run dev-db start && pnpm run dev-db functions serve --no-verify-jwt",
    "dev-db-stop": "pnpm run dev-db stop",
    "dev-frontend": "pnpm --filter frontend dev",
    "dev-backend": "pnpm --filter backend dev",
    "dev": "concurrently \"pnpm run deb-dv-start\" \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build-frontend": "pnpm --filter frontend build",
    "build-backend": "pnpm --filter backend build",
    "build": "pnpm -r build",
    "start": "pnpm --filter backend start",
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
