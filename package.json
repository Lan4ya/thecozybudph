{
  "name": "cozybud",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:sb": "cd backend && pn exec supabase start && pn exec supabase functions serve --no-verify-jwt",
    "dev:fe": "pn -F frontend dev",
    "dev": "concurrently \"pn dev:sb\" \"pn dev:fe\"",
    "build:fe": "pn -F frontend build",
    "type:sb": "pn -F backend type:sb",
    "type:fe": "tsgo --noEmit -p ./frontend/tsconfig.json",
    "type:schemas": "tsgo --noEmit -p ./packages/schemas/tsconfig.json",
    "type": "pn type:fe && pn type:schemas && pn type:sb",
    "db:migrate": "pn -F backend db:migrate",
    "db:seed": "pn -F backend db:seed",
    "test:sb": "pn -F backend test:sb",
    "add:sb": "pn -F backend add:sb",
    "update:sb": "pn -F backend update:sb",
    "update:latest:sb": "pn -F backend update:latest:sb",
    "add:sb:tests": "pn -F backend add:sb:tests",
    "update:sb:tests": "pn -F backend update:sb:tests",
    "update:latest:sb:tests": "pn -F backend update:latest:sb:tests",
    "schemas:gen": "pn -F backend schemas:gen",
    "docs:gen": "pn -F schemas docs:gen"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260521.1",
    "concurrently": "^9.2.1",
    "supabase": "^2.98.2"
  }
}
