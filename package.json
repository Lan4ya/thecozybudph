{
  "name": "TheCozyBud",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "pnpm -F frontend dev",
    "dev:backend": "cd backend && sudo systemctl start docker && pnpm supabase functions serve --no-verify-jwt",
    "build:frontend": "pnpm -F frontend build",
    "build": "pnpm -r build",
    "type": "pnpm -F backend check:supabase-functions && tsc --noEmit -p ./frontend/tsconfig.json && tsc --noEmit -p ./packages/schemas/tsconfig.json",
    "pkg:generate": "pnpm -F backend pkg:generate"
  }
}
