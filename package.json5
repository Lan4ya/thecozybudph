{
  "name": "thecozybudph",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev-backend": "pnpm --filter backend dev",
    "dev-frontend": "pnpm --filter frontend dev",
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter backend start",
    // https://supabase.com/docs/guides/functions/quickstart
    "supabase": "pnpm dlx supabase --workdir ./backend",
    "supabase-start": "pnpm run supabase start",
    "supabase-stop": "pnpm run supabase stop",
    "supabase-restart": "pnpm run supabase restart",
    "supabase-status": "pnpm run supabase status"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
