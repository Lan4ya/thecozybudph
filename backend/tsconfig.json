{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "express"
    ],
    "lib": [
      "ES2022"
    ],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist-backend",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        ".src/*"
      ],
      "@ts-pages/*": [
        "pages/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/db/supabase"
  ]
}
