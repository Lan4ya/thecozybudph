{
  "name": "@cozybud/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schemas:gen": "mkdir -p  ./supabase/functions/_shared/schemas && rm -rf ./supabase/functions/_shared/schemas/* && cp -r ../packages/schemas/src/* ./supabase/functions/_shared/schemas/",
    "storage:init": "pn tsx ./scripts/initBuckets.ts",
    "db:migrate": "pn exec drizzle-kit generate && pn exec supabase migrations up --include-all && pn exec supabase gen types typescript --local > ../packages/schemas/src/types/db/supabase.types.ts",
    "db:seed:products": "pn tsx ./scripts/seedProducts.ts",
    "db:seed:admin": "pn tsx ./scripts/seedAdmin.ts",
    "db:seed:users": "pn tsx ./scripts/seedUsers.ts",
    "db:seed": "pn tsx ./scripts/seedAll.ts",
    "dev:webhook": "pn tsx ./scripts/webhooks/test-shipment-webhook.ts",
    "test:sb": "deno task --config ./supabase/tests/deno.json test-all",
    "type:sb": "deno task --config ./supabase/functions/deno.json type-all",
    "add:sb": "cd ./supabase/functions && deno add",
    "remove:sb": "cd ./supabase/functions && deno remove",
    "update:sb": "deno task --config ./supabase/functions/deno.json update-all",
    "update:latest:sb": "deno task --config ./supabase/functions/deno.json update-all:latest",
    "add:sb:tests": "deno add --config ./supabase/tests/deno.json",
    "remove:sb:tests": "deno remove --config ./supabase/tests/deno.json",
    "update:sb:tests": "deno task --config ./supabase/tests/deno.json update",
    "update:latest:sb:tests": "deno task --config ./supabase/tests/deno.json update:latest"
  },
  "devDependencies": {
    "@cozybud/schemas": "workspace:*",
    "@supabase/supabase-js": "^2.76.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "link:drizzle-orm",
    "drizzle-seed": "^0.3.1",
    "openapi-fetch": "^0.17.0",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.9",
    "postgres-js": "link:drizzle-orm/postgres-js",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
