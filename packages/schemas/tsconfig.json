{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/"
  ]
}
