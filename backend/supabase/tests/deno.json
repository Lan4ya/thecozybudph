{
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "update": "deno update",
    "update:latest": "deno update --latest",
    "test:integration": "deno test --allow-all --no-check ./integrations/*test.ts --parallel",
    "test:unit": "deno test --allow-all --no-check ./unit/*test.ts --parallel",
    "test:watch": "deno test --watch",
    "test:orders": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/orders.test.ts",
    "test:addresses": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/addresses.test.ts",
    "test:carts": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/carts.test.ts",
    "test:profiles": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/profiles.test.ts",
    "test:admin-products": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/admin-products.test.ts",
    "test:admin-orders": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/admin-orders.test.ts",
    "test:admin-analytics": "deno test --preload=./helpers/setup.ts --no-check --allow-all ./integrations/admin-analytics.test.ts",
    "test-all": "deno test --preload=./helpers/setup.ts --no-check --allow-all --parallel ./**/*test.ts"
  },
  "imports": {
    "@functions/": "../functions/",
    "@shared/": "../functions/_shared/",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing/mock": "jsr:@std/testing@1.0.18/mock",
    "@std/testing/bdd": "jsr:@std/testing@1.0.18/bdd",
    "@std/dotenv": "jsr:@std/dotenv@0.225.6",
    "supabase": "npm:@supabase/supabase-js@^2.106.0",
    "hono": "npm:hono@^4.12.19",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.4.0",
    "@hono/zod-validator": "npm:@hono/zod-validator@0.8.0",
    "hono-rate-limiter": "npm:hono-rate-limiter@0.5.3",
    "zod": "npm:zod@^4.4.3",
    "axios": "npm:axios@^1.16.1",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "drizzle-zod": "npm:drizzle-zod@0.8.3",
    "postgres": "npm:postgres@3.4.9",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.1",
    "p-limit": "npm:p-limit@^7.3.0",
    "@lalamove/lalamove-js": "npm:@lalamove/lalamove-js@^1.1.0"
  }
}
